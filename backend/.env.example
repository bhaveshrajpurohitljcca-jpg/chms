PROJECT_NAME="College Hackathon Management System"
ENVIRONMENT="local"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Database Connection (Supabase PostgreSQL Connection String)
DATABASE_URL="postgresql://postgres:[password]@db.[supabase-ref].supabase.co:5432/postgres"

# Supabase Auth and Storage Integration
SUPABASE_URL="https://[supabase-ref].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
JWT_SECRET="your-supabase-jwt-secret-or-custom-secret"
JWT_ALGORITHM="HS256"
